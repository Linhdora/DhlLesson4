@model List<Product>
@{
    ViewData["Title"] = "Trang chủ";
    string? selectedCategory = ViewBag.SelectedCategory;
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-md-3">
            @await Html.PartialAsync("_CategoryPartial", selectedCategory)
        </div>

        <div class="col-md-9">
            <div class="card">
                <div class="card-header bg-primary text-white fw-bold">
                    @(string.IsNullOrEmpty(selectedCategory) ? "Sản phẩm mới nhất" : "Danh mục: " + selectedCategory)
                </div>
                <div class="card-body border border-success rounded m-2">

                    <div class="row">
                        @if (Model.Count == 0)
                        {
                            <p class="text-muted">Không có sản phẩm nào trong danh mục này.</p>
                        }
                        @foreach (var p in Model)
                        {
                            <div class="col-md-4 mb-4 text-center">
                                <img src="@p.ImageUrl" class="img-fluid" alt="@p.Name" />
                                <p class="mt-2 mb-0">@p.Name</p>
                            </div>
                        }
                    </div>

                    <hr />

                    @await Component.InvokeAsync("HotProduct", new { category = selectedCategory })

                </div>
            </div>
        </div>
    </div>
</div>