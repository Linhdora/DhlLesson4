@model List<Product>

<div class="row">
    @if (Model == null || Model.Count == 0)
    {
        <p class="text-muted">Không có sản phẩm nào.</p>
    }
    @foreach (var p in Model)
    {
        <div class="col-md-4 mb-4 text-center">
            <img src="@p.ImageUrl" class="img-fluid" alt="@p.Name" />
            <p class="mt-2 mb-0">@p.Name</p>
        </div>
    }
</div>