@model string
@{
    var categories = DhlBaiTap_lesson4.Data.ProductRepository.Categories;
}

<div class="card mb-3">
    <div class="card-header bg-primary text-white fw-bold">
        Danh mục sản phẩm
    </div>
    <ul class="list-group list-group-flush">
        <li class="list-group-item @(string.IsNullOrEmpty(Model) ? "active" : "")">
            <a asp-controller="Home" asp-action="Index"
               class="text-decoration-none @(string.IsNullOrEmpty(Model) ? "text-white" : "text-dark")">
                Tất cả sản phẩm
            </a>
        </li>
        @foreach (var cate in categories)
        {
            <li class="list-group-item @(Model == cate ? "active" : "")">
                <a asp-controller="Home" asp-action="Index" asp-route-category="@cate"
                   class="text-decoration-none @(Model == cate ? "text-white" : "text-dark")">
                    @cate
                </a>
            </li>
        }
    </ul>
</div>

<div class="text-center">
    <img src="~/images/banner.png" class="img-fluid rounded" alt="Banner quảng cáo" />
</div>