@{
    ViewData["Title"] = "Home Page";
}

<partial name="_Banner" />

<hr />

<!-- Nút bấm-->
<button id="loadAjax" class="btn btn-sm btn-primary">
    Click load book từ partialResult
</button>

<hr />

<!-- Nội dung sẽ được load từ partial view vào đây-->
<div id="data-from-ajax" class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    Loading data....
</div>

<hr />

<div class="row">...</div>


@section Scripts {
    <script>
        // gọi sự kiện click vào nút bấm có id ="loadAjax"
        $('#loadAjax').click(function () {

            // thông qua ajax load nội dung từ partial view vào id="data-from-ajax"
            $('#data-from-ajax').load("/Book/PopularBook");

        })
    </script>
}
<h2>Popular Book Load từ BookComponent</h2>
@await Component.InvokeAsync("Book")